# ─────────────────────────────────────────────────────────────
#  Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
#  가상환경 (run_*.sh 가 자동 생성)
# ─────────────────────────────────────────────────────────────
.venv/
venv/
env/

# ─────────────────────────────────────────────────────────────
#  OS / 에디터
# ─────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
.vscode/
.idea/
*.swp

# MS Office 임시/잠금 파일 (~$Vanguard_....docx 등)
~$*

# ─────────────────────────────────────────────────────────────
#  센서/네트워크 설정 백업 (배포 고유값 — 백업본만 무시)
#    · epl_config.json 본체는 센서 목록·캘리브레이션이라 커밋합니다.
#      비밀번호는 저장되지 않지만, 네트워크 식별정보(MAC/host)를 커밋하고
#      싶지 않으면 아래 한 줄의 주석을 해제하고 예시(epl_config.example.json)를 두세요.
# epl_config.json
epl_config.json.bak
epl_config_backup.json
*.bak

# ─────────────────────────────────────────────────────────────
#  디버그 · 최적화 산출물 (대용량 · 재생성 가능)
#    원시 기록 JSONL, 비교 영상 MP4, 상관분석 CSV/그림 등.
#    최적 하이퍼파라미터(best_params.yaml)와 튜닝 입력 기록(logs_for_optimization/)만
#    예외로 추적합니다 — 전자는 run_gui.sh 가 기본으로 불러오는 실사용 결과이고,
#    후자는 best_params.yaml 을 만들어낸 입력이라 함께 없으면 재튜닝·재현이 불가합니다.
# ─────────────────────────────────────────────────────────────
debug_logs/*
!debug_logs/best_params.yaml
# ★ 디렉터리 자체를 되살려야 한다 — 부모가 제외된 상태로는 그 안의 파일을 다시
#   포함시킬 수 없어서(git 은 제외된 디렉터리로 내려가지 않는다) 파일 패턴만
#   추가하면 아무 효과가 없다.
!debug_logs/logs_for_optimization/

# 로그
*.log
